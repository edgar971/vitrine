# TLS for drop. Caddy keeps the original Host header, which drop checks (spec § 7.4), and sets
# X-Forwarded-For, which drop trusts from the compose `edge` subnet only.
{$DROP_DOMAIN} {
	encode zstd gzip

	# Optional hardening (docs/design.md § 12): if every agent reaches drop another way, keep
	# the write surface off the internet and serve only the views.
	# @writes path /mcp /mcp/* /api/* /u/*
	# respond @writes 404

	reverse_proxy drop:8080
}
